# ============================================================
# Dockerfile.slim — Lightweight dashboard-only image
# Use this for local testing in Codespaces or low-disk environments
# The full Dockerfile is used for Hugging Face deployment
# ============================================================
# Build:   docker build -f Dockerfile.slim -t fraud-triage-slim .
# Run:     docker run -p 8501:8501 fraud-triage-slim
# ============================================================

FROM python:3.11-slim

WORKDIR /app

# System dependencies
RUN apt-get update && apt-get install -y \
    curl \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Install only what the dashboard needs to RUN
# (not the full training stack)
RUN pip install --no-cache-dir \
    pandas==2.1.0 \
    numpy==1.26.0 \
    scikit-learn==1.3.2 \
    xgboost==2.0.3 \
    joblib==1.3.2 \
    shap==0.44.0 \
    streamlit==1.30.0 \
    plotly==5.18.0 \
    chromadb==0.4.22 \
    sentence-transformers==2.2.2 \
    openai==1.12.0 \
    python-dotenv==1.0.0 \
    pyyaml==6.0.1 \
    mlflow==2.10.0 \
    pandera==0.18.0 \
    evidently==0.4.16 \
    scipy==1.11.4

# Copy project files
COPY . .

# Create output directories
RUN mkdir -p outputs/eda outputs/plots outputs/metrics outputs/models \
             outputs/shap outputs/improvement outputs/rag \
             outputs/fairness outputs/monitoring outputs/temporal

EXPOSE 8501

ENV PYTHONUNBUFFERED=1
ENV STREAMLIT_SERVER_PORT=8501
ENV STREAMLIT_SERVER_ADDRESS=0.0.0.0
ENV STREAMLIT_SERVER_HEADLESS=true
ENV STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

CMD ["python", "-m", "streamlit", "run", "app.py", \
     "--server.port=8501", \
     "--server.address=0.0.0.0", \
     "--server.headless=true"]
