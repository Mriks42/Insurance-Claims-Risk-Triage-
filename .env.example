# Copy this file to .env and fill in your key
# The RAG pipeline will automatically load it via python-dotenv

# OpenAI API key — enables GPT-4o-mini triage brief generation
# Get one at: https://platform.openai.com/api-keys
# Without this key the pipeline uses the structured template fallback (fully functional)
OPENAI_API_KEY=sk-your-key-here
